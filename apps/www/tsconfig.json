{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "scripts/build-registry.mts",
    "next.config.mjs",
    ".next/dev/types/**/*.ts"
, "src/lib/NoiseBackground.tsx", "src/components/docs/ts/js/Addaccount.jsx", "src/components/docs/ts/js/Button.jsx", "src/components/docs/ts/js/Chatbot.jsx", "src/components/docs/ts/js/Filterchip.jsx", "src/components/docs/ts/js/DataViewPanel.jsx", "src/components/docs/ts/js/Filters.jsx", "src/components/docs/ts/js/Header.jsx", "src/components/docs/ts/js/MultipleFilter.jsx", "src/components/docs/ts/js/notification.jsx", "src/components/docs/ts/js/Sidebar.jsx", "src/components/docs/ts/js/Pagination.jsx", "src/components/docs/ts/js/Skeleton.jsx", "src/components/docs/ts/js/SpiderView.jsx", "src/components/docs/ts/js/Table.jsx", "src/components/docs/ts/js/Toggle.jsx", "src/components/docs/ts/js/Timeline.jsx", "src/components/docs/js/Navbar.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}